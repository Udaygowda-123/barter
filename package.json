{
  "name": "swapd",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "bootstrap": "pnpm --filter @swapd/shared-types build && pnpm --filter @swapd/validation build",
    "dev": "pnpm --filter @swapd/web dev",
    "build": "pnpm bootstrap && pnpm --filter @swapd/web build",
    "start": "pnpm --filter @swapd/web start",
    "seed": "pnpm --filter @swapd/web seed"
  }
}
