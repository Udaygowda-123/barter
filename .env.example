# Copy to .env.local (the only env file) and fill in.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/swapd?retryWrites=true&w=majority
JWT_ACCESS_SECRET=at-least-32-random-characters

# Public URL used in email links (Vercel: set to your production URL, e.g. https://yourapp.vercel.app)
APP_URL=http://localhost:3000

# Email (password reset + verification). Pick ONE:
#  A) Gmail / any SMTP — for Gmail: enable 2-Step Verification, then create an "App password"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="SWAPD <you@gmail.com>"
#  B) Resend (needs a verified domain to email arbitrary users): RESEND_API_KEY=re_xxx

# Photo storage (production). Pick ONE; with neither, local dev stores files in .uploads
#  A) Cloudinary (free) — copy the value from Cloudinary → Settings → API Keys → "API environment variable"
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
#  B) Vercel Blob
BLOB_READ_WRITE_TOKEN=
