# Copy to .env.local (the only env file) and fill in.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/swapd?retryWrites=true&w=majority
JWT_ACCESS_SECRET=at-least-32-random-characters
# Optional: Vercel Blob token for photo uploads in production (local dev stores in .uploads)
BLOB_READ_WRITE_TOKEN=
